    <div class="container">
        <h1>🌸 Таємне послання 🌸</h1>
        <p>Щоб дізнатися координати свого наступного подарунка, введи наш табірний пароль:</p>
        
        <input type="text" id="password" placeholder="Введи пароль..." autocomplete="off">
        <br>
        <button onclick="checkPassword()">Відкрити таємницю</button>
        
        <div id="result"></div>
    </div>

    <script>
        function checkPassword() {
            // Пароль вже встановлено на "ромашка"
            const correctPassword = "ромашка"; 
            
            const pwd = document.getElementById('password').value.toLowerCase().trim();
            const resultDiv = document.getElementById('result');
            
            if (pwd === correctPassword) {
                resultDiv.innerHTML = "✨ ПАРОЛЬ ПРИЙНЯТО! ✨<br><br>Твій солодкий допінг чекає на тебе <strong>[ТУТ ВПИШИ ЛОКАЦІЮ, наприклад: під подушкою на твоєму ліжку]</strong>. Забирай і набирайся сил!";
                resultDiv.style.color = "#4b0082";
            } else {
                resultDiv.innerHTML = "Ой, не те! Згадай наші приколи і спробуй ще раз 😉";
                resultDiv.style.color = "red";
            }
        }
    </script>

